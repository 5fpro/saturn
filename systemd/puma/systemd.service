[Unit]
Description=Puma for {{APP_NAME}} app
After=network.target

[Service]
Type=simple
WorkingDirectory={{APP_ROOT}}
PIDFile={{PID_FILE_PATH}}
ExecStart={{START_CMD}}
ExecReload=/bin/kill USR1 $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID
Restart=always

[Install]
WantedBy=multi-user.target
